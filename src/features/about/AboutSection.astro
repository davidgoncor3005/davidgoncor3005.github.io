---
import type { Translations } from "../../i18n";

interface Props {
    t: Translations;
}

const { t } = Astro.props as Props;
const experienceItems = t.experience.items;
const educationItems = t.experience.education;
const certificationItems = t.experience.certificationItems;
const cvPath = "/docs/cv/cv-david-gonzalez-cordoba.pdf";
const cvDownloadName = "cv-david-gonzalez-cordoba.pdf";
---

<section class="about-section" aria-labelledby="about-title" data-about-profile>
    <div class="about-profile">
        <header class="about-profile__intro">
            <h1 id="about-title" class="section-title">{t.about.title}</h1>
            <p class="about-profile__description">
                {t.about.intro.beforeBackend}
                <strong>{t.about.intro.backend}</strong>{t.about.intro.beforeFrontend}
                <strong>{t.about.intro.frontend}</strong>{t.about.intro.beforeDatabases}
                <strong>{t.about.intro.databases}</strong>{t.about.intro.beforeDocumentation}
                <strong>{t.about.intro.documentation}</strong>{t.about.intro.beforeDeployment}
                <strong>{t.about.intro.deployment}</strong>{t.about.intro.end}
            </p>
        </header>

        <div class="about-profile__workspace">
            <div class="about-profile__tablist" role="group" aria-label={t.about.sectionsLabel} data-about-tablist hidden>
                <button type="button" aria-controls="about-panel-education" data-about-tab="education">
                    <i class="bi bi-mortarboard" aria-hidden="true"></i>
                    <span>{t.experience.tabs.education}</span>
                </button>
                <button type="button" aria-controls="about-panel-experience" data-about-tab="experience">
                    <i class="bi bi-briefcase" aria-hidden="true"></i>
                    <span>{t.experience.tabs.work}</span>
                </button>
                <button type="button" aria-controls="about-panel-certifications" data-about-tab="certifications">
                    <i class="bi bi-award" aria-hidden="true"></i>
                    <span>{t.experience.tabs.certifications}</span>
                </button>
            </div>

            <section id="about-panel-education" class="about-profile__group" aria-labelledby="about-education-title" data-about-panel="education">
                <h2 id="about-education-title" class="about-profile__group-title">{t.experience.tabs.education}</h2>
                <div class="about-profile__list">
                    {educationItems.map((item) => (
                        <article class="about-profile__summary">
                            <div class="about-profile__card-heading">
                                <div class="about-profile__logo" aria-hidden="true">
                                    <img src={item.logoImage} alt="" loading="lazy" />
                                </div>
                                <div class="about-profile__card-copy">
                                    <div class="about-profile__title-row">
                                        <h3>{item.title}</h3>
                                        {item.tag && <span class="about-profile__tag">{item.tag}</span>}
                                    </div>
                                    <div class="about-profile__context">
                                        <span><i class="bi bi-building" aria-hidden="true"></i>{item.center}</span>
                                        <span><i class="bi bi-calendar3" aria-hidden="true"></i>{item.date}</span>
                                    </div>
                                </div>
                            </div>
                            {item.description && <p class="about-profile__summary-text">{item.description}</p>}
                            {item.tools.length > 0 && (
                                <div class="about-profile__tools" aria-label={t.experience.labels.tools}>
                                    {item.tools.map((tool) => <span>{tool}</span>)}
                                </div>
                            )}
                        </article>
                    ))}
                </div>
            </section>

            <section id="about-panel-experience" class="about-profile__group" aria-labelledby="about-experience-title" data-about-panel="experience">
                <h2 id="about-experience-title" class="about-profile__group-title">{t.experience.tabs.work}</h2>
                <div class="about-profile__list">
                    {experienceItems.map((item) => (
                        <article class="about-profile__summary">
                            <div class="about-profile__card-heading">
                                <div class="about-profile__logo" aria-hidden="true">
                                    <img src={item.logoImage} alt="" loading="lazy" />
                                </div>
                                <div class="about-profile__card-copy">
                                    <div class="about-profile__title-row">
                                        <h3>{item.company}</h3>
                                        <span class="about-profile__tag">{item.tag}</span>
                                    </div>
                                    <p class="about-profile__role">{item.role}</p>
                                    <div class="about-profile__context">
                                        <span><i class="bi bi-geo-alt" aria-hidden="true"></i>{item.location}</span>
                                        <span><i class="bi bi-calendar3" aria-hidden="true"></i>{item.date}</span>
                                    </div>
                                </div>
                            </div>
                            <p class="about-profile__summary-text">{item.description}</p>
                            <div class="about-profile__tools" aria-label={t.experience.labels.tools}>
                                {item.tools.map((tool) => <span>{tool}</span>)}
                            </div>
                            <ul class="about-profile__tasks" aria-label={t.about.tasksLabel}>
                                {item.tasks.map((task) => <li>{task}</li>)}
                            </ul>
                        </article>
                    ))}
                </div>
            </section>

            <section id="about-panel-certifications" class="about-profile__group" aria-labelledby="about-certifications-title" data-about-panel="certifications">
                <h2 id="about-certifications-title" class="about-profile__group-title">{t.experience.tabs.certifications}</h2>
                <div class="about-profile__list">
                    {certificationItems.map((item) => (
                        <article class="about-profile__summary">
                            <div class="about-profile__card-heading">
                                <div class="about-profile__logo" aria-hidden="true">
                                    <img src={item.logoImage} alt="" loading="lazy" />
                                </div>
                                <div class="about-profile__card-copy">
                                    <h3>{item.title}</h3>
                                    <div class="about-profile__context">
                                        <span><i class="bi bi-building" aria-hidden="true"></i>{item.center}</span>
                                        <span><i class="bi bi-calendar3" aria-hidden="true"></i>{item.date}</span>
                                    </div>
                                </div>
                            </div>
                            <img
                                class="about-profile__certificate-image"
                                src={item.image}
                                alt={item.title}
                                width="2000"
                                height="1545"
                                loading="lazy"
                            />
                        </article>
                    ))}
                </div>
            </section>
        </div>

        <section class="about-cv" aria-labelledby="about-cv-title">
            <header class="about-cv__header">
                <h2 id="about-cv-title">{t.about.cv.tab}</h2>
                <div class="about-cv__actions">
                    <a class="about-download" href={cvPath} download={cvDownloadName}>
                        <i class="bi bi-download" aria-hidden="true"></i>
                        <span>{t.about.cv.download}</span>
                    </a>
                </div>
            </header>

            <div class="about-preview">
                <iframe src={cvPath} title={t.about.cv.tab} loading="lazy"></iframe>
                <p class="about-preview__fallback">
                    {t.about.cv.fallback}
                    {" "}
                    <a href={cvPath} target="_blank" rel="noopener noreferrer">{t.about.cv.open}</a>
                </p>
            </div>
        </section>
    </div>
</section>

<script>
    const initAboutTabs = () => {
        const section = document.querySelector<HTMLElement>("[data-about-profile]");
        if (!section) return;

        const controls = section.querySelector<HTMLElement>("[data-about-tablist]");
        const buttons = section.querySelectorAll<HTMLButtonElement>("[data-about-tab]");
        const panels = section.querySelectorAll<HTMLElement>("[data-about-panel]");

        if (!controls || buttons.length === 0 || panels.length === 0) return;

        const showPanel = (name: string) => {
            buttons.forEach((button) => {
                button.setAttribute("aria-pressed", String(button.dataset.aboutTab === name));
            });

            panels.forEach((panel) => {
                panel.hidden = panel.dataset.aboutPanel !== name;
            });
        };

        buttons.forEach((button) => {
            button.addEventListener("click", () => showPanel(button.dataset.aboutTab ?? "experience"));
        });

        controls.hidden = false;
        section.dataset.tabsReady = "true";
        showPanel("experience");
    };

    initAboutTabs();
</script>
